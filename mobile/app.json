{
  "expo": {
    "name": "Estate-EZ Capture",
    "slug": "caringtransitions-capture",
    "version": "1.1.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "caringtransitions",
    "userInterfaceStyle": "dark",
    "runtimeVersion": "1.1.0",
    "updates": {
      "url": "https://u.expo.dev/dfb4d2a5-1b94-449c-bc28-43466a46803d",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Capture estate lot photos and short videos for catalog upload.",
        "NSMicrophoneUsageDescription": "Record audio with lot videos.",
        "NSPhotoLibraryUsageDescription": "Estate-EZ saves a backup copy of lot photos and videos into the Photos app.",
        "NSPhotoLibraryAddUsageDescription": "Estate-EZ saves a backup copy of each lot photo and video into the Photos app.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.caringtransitions.capture"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#070708",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.caringtransitions.capture",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Capture estate lot photos and short videos for catalog upload.",
          "microphonePermission": "Record audio with lot videos.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Estate-EZ saves a backup copy of lot photos and videos into the Photos app.",
          "savePhotosPermission": "Estate-EZ saves a backup copy of each lot photo and video into the Photos app.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": []
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#070708"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dfb4d2a5-1b94-449c-bc28-43466a46803d"
      }
    },
    "owner": "vtz1900"
  }
}
