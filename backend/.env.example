SECRET_KEY=change-me
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/caring_transitions

# development | production — production enforces strong SECRET_KEY, Postgres, and CORS_ORIGINS.
ENVIRONMENT=development

# Production: comma-separated origins for the Next.js site (e.g. https://your-app.up.railway.app).
# Localhost is always allowed for development. Do not use "*".
CORS_ORIGINS=

# Optional: comma-separated API Host header values (e.g. api.example.com) for TrustedHostMiddleware.
TRUSTED_HOSTS=

# When ENVIRONMENT=production and this is false, POST /auth/register returns 403 (use after bootstrap).
ALLOW_OPEN_REGISTRATION=true

# JWT lifetime in minutes (default 1440 = 24 hours).
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Recycle DB pool connections (seconds).
DB_POOL_RECYCLE=280

GOOGLE_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_API_VERSION=v1beta
SKIP_TAPE_VERIFY=false
# Concurrent photos in flight to Gemini (lower = less RAM; Railway often needs ≤6).
GEMINI_PARALLELISM=5
GEMINI_GLOBAL_CONCURRENCY=3
# Max catalog jobs running at once per account (worker + optional in-API threads).
CATALOG_JOB_MAX_CONCURRENT=1
# API service on Railway with a dedicated worker: set false so Gemini runs off the web dyno.
# Worker service: leave true (default) or unset.
RUN_CATALOG_JOBS_IN_PROCESS=true
WORKER_ISOLATE_JOBS=true
# Worker poll interval (seconds) for ``python -m app.worker``.
WORKER_POLL_SECONDS=2
# Max detail for AI + listings (raise only on hosts with enough RAM).
GEMINI_IMAGE_MAX_EDGE=2048
GEMINI_JPEG_QUALITY=85
PIPELINE_WORKING_MAX_EDGE=1600
PIPELINE_WORKING_JPEG_QUALITY=80
PIPELINE_TRIAGE_PARALLEL=2
TRIAGE_IMAGE_MAX_EDGE=2048
CATALOG_UPLOAD_MAX_EDGE=4096
CATALOG_UPLOAD_JPEG_QUALITY=98
TAPE_FOCUS_ENABLED=true
LAST_KNOWN_SKU_FALLBACK=true
# Max seconds for one estate-tape SKU verification call (SDK + REST); prevents stuck "processing" jobs.
TAPE_VERIFY_TOTAL_TIMEOUT_SECONDS=120
# Optional extra rules appended to tape audit prompts (same text for SDK + REST paths).
TAPE_VERIFY_PROMPT_SUFFIX=

# Suggestions form → email (Gmail: use an App Password, not your normal password)
FEEDBACK_TO_EMAIL=zorntyler540@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Optional; defaults to SMTP_USER
SMTP_FROM_EMAIL=

# Facebook Page posting (optional). Leave META_APP_ID empty to hide the feature.
# Create a Business-type app at https://developers.facebook.com — add Facebook Login,
# Valid OAuth Redirect URI = META_OAUTH_REDIRECT_URI, and add the Page owner as an
# app Admin/Developer (Pages they admin can be posted to without App Review).
META_APP_ID=
META_APP_SECRET=
META_OAUTH_REDIRECT_URI=http://localhost:8000/integrations/facebook/oauth/callback
# Optional. If unset, token encryption is derived from SECRET_KEY.
META_TOKEN_ENCRYPTION_KEY=
# Dashboard origin for the OAuth return (Account settings). Falls back to CORS_ORIGINS.
PUBLIC_WEB_ORIGIN=http://localhost:3000

# Catalog images are stored on disk under backend/data/uploads/catalog/ (see DEPLOY.md §7b).
# Back up Postgres AND the API volume (or use sale ZIP exports). S3/R2 is planned for off-server backup.
