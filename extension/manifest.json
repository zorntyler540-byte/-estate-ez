{
  "manifest_version": 3,
  "name": "Estate-Ez Link",
  "version": "1.0.2",
  "description": "Connects Estate-Ez AI to CT Seller.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "https://*.up.railway.app/*",
    "https://*.railway.app/*",
    "https://*.ctbids.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://*.ctbids.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
