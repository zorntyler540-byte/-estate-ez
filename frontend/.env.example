# Copied into the Next.js client at `npm run dev` / `npm run build`.
# `npm run dev` defaults to http://localhost:8000. `npm run build` requires it (https, or
# http://localhost for a local production build). There is no production fallback.

NEXT_PUBLIC_API_BASE=http://localhost:8000

# Optional. Direct HTTPS URL for the Windows CTBids Sale Suite zip (~700 MB).
# If unset, Desktop tools looks for /downloads/CTBids-Sale-Suite.zip in this app.
# NEXT_PUBLIC_SALE_SUITE_DOWNLOAD_URL=
