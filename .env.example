# Root env is only used by the legacy desktop CLI (`python main.py`).
# The SaaS API reads `backend/.env` — copy `backend/.env.example` instead.

# Use GOOGLE_API_KEY only. GEMINI_API_KEY is deprecated; the API also reads this file when
# run from the repo root (e.g. alembic) and refuses to start if the two keys differ.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_API_VERSION=v1beta
SKIP_TAPE_VERIFY=false
