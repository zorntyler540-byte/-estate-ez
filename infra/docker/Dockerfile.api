# Build from repository root. Runs migrations then FastAPI (cwd = backend so data/uploads resolves).
FROM python:3.12-slim-bookworm

RUN apt-get update \
    && apt-get install -y --no-install-recommends libheif1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt \
    && python -c "from rembg import new_session; new_session('u2netp')"

COPY alembic.ini .
COPY backend ./backend

RUN mkdir -p backend/data/uploads

WORKDIR /app
ENV PYTHONUNBUFFERED=1

EXPOSE 8000
CMD sh -c "python -m alembic upgrade head && cd backend && uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"
