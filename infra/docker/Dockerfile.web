# Build from repository root. NEXT_PUBLIC_API_BASE must be your public API URL (https://...).
FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./

# Required, no default: Railway passes the web service's NEXT_PUBLIC_API_BASE variable as this build arg.
ARG NEXT_PUBLIC_API_BASE
ENV NEXT_PUBLIC_API_BASE=${NEXT_PUBLIC_API_BASE}
ARG NEXT_PUBLIC_SALE_SUITE_DOWNLOAD_URL=https://drive.google.com/file/d/1bDhxQqcDpDCKNbCxD5y7p-ZjmSGI11iS/view?usp=sharing
ENV NEXT_PUBLIC_SALE_SUITE_DOWNLOAD_URL=${NEXT_PUBLIC_SALE_SUITE_DOWNLOAD_URL}

# Fail the image unless the API URL is set to a public https URL (never localhost).
RUN case "$NEXT_PUBLIC_API_BASE" in \
      "") echo "NEXT_PUBLIC_API_BASE build arg is required (public https API URL, e.g. https://your-api.up.railway.app)" >&2; exit 1 ;; \
      *localhost*|*127.0.0.1*) echo "NEXT_PUBLIC_API_BASE cannot be localhost in Dockerfile.web" >&2; exit 1 ;; \
      https://*) ;; \
      *) echo "NEXT_PUBLIC_API_BASE must start with https:// in Dockerfile.web" >&2; exit 1 ;; \
    esac

RUN npm run build

FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production

COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static
COPY --from=build /app/public ./public

EXPOSE 3000
ENV PORT=3000
# Linux sets HOSTNAME to the container id; Next's standalone server uses HOSTNAME for bind address.
CMD ["sh", "-c", "exec env HOSTNAME=0.0.0.0 node server.js"]
