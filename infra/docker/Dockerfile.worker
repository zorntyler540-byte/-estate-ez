# Build from repository root. Same image deps as the API; no HTTP server / no migrations.
# Railway: new service → Dockerfile path infra/docker/Dockerfile.worker → copy API variables
# (DATABASE_URL, GOOGLE_API_KEY, R2_*, SECRET_KEY, …). Do not set RUN_CATALOG_JOBS_IN_PROCESS=false here.
FROM python:3.12-slim-bookworm

RUN apt-get update \
    && apt-get install -y --no-install-recommends libheif1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY alembic.ini .
COPY backend ./backend

RUN mkdir -p backend/data/uploads

WORKDIR /app/backend
ENV PYTHONUNBUFFERED=1
ENV RUN_CATALOG_JOBS_IN_PROCESS=true

CMD ["python", "-m", "app.worker"]
