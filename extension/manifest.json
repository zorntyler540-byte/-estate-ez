{
  "manifest_version": 3,
  "name": "Estate-Ez Link",
  "version": "1.0.9",
  "description": "Connects Estate-Ez AI to CT Seller.",
  "permissions": ["activeTab", "scripting", "storage", "sidePanel"],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "https://*.up.railway.app/*",
    "https://*.railway.app/*",
    "https://*.ctbids.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Estate-Ez — open side panel"
  },
  "content_scripts": [
    {
      "matches": ["https://*.ctbids.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
